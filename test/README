
This directory is intended for PlatformIO Test Runner and project tests.

Unit Testing is a software testing method by which individual units of
source code, sets of one or more MCU program modules together with associated
control data, usage procedures, and operating procedures, are tested to
determine whether they are fit for use. Unit testing finds problems early
in the development cycle.

More information about PlatformIO Unit Testing:
- https://docs.platformio.org/en/latest/advanced/unit-testing/index.html

Host tests used in this repo (run from the repo root):

  g++ -std=c++17 -Wall -Wextra -Werror test/pidf_controller_test.cpp src/Control/PidfController.cpp -o /tmp/t && /tmp/t
  g++ -std=c++17 -Wall -Wextra -Werror test/shot_table_lookup_test.cpp -o /tmp/t && /tmp/t
  g++ -std=c++17 -Wall -Wextra -Werror test/vision_rotate_bench_state_test.cpp src/Control/PidfController.cpp -o /tmp/t && /tmp/t
  # Production turret vision-follow (VisionFollowController) with the real
  # production gains, cross-checked frame by frame against the bench above.
  g++ -std=c++17 -Wall -Wextra -Werror test/vision_follow_controller_test.cpp src/Control/PidfController.cpp -o /tmp/t && /tmp/t
  node test/vision_rotate_page_test.cjs
  node test/dashboard_control_test.cjs

  node test/dashboard_page_test.cjs

  # Shared wireless channel/status codec (src/IO/RcControlMap.c), used by the
  # Mega, the robot STM32 bridge and the ground STM32.
  gcc -std=c11 -Wall -Wextra -Werror test/rc_control_map_test.c src/IO/RcControlMap.c -lm -o /tmp/t && /tmp/t

  # Operator control firmware path: real ManualControl.cpp + Auto.cpp +
  # Dribbler.cpp on fake Arduino pins/time/Serial (test/host_stubs/). Wired +
  # wireless, control authority, feed-tower trigger, operator modes (M,
  # semi-auto F, full-auto firing). Build both variants (and the wired-manual
  # bench variant: add -DTEL_WIRED_MANUAL_ONLY -Wno-unused-function).
  gcc -c src/IO/RcControlMap.c -o /tmp/rcmap.o
  g++ -std=c++17 -Wall -Wextra -Werror -I test/host_stubs -DTEL_HOST_TEST_PIN_TABLE_CONFIRMED=true \
      test/manual_control_test.cpp test/host_stubs/host_stubs.cpp src/IO/ManualControl.cpp src/Auto/Auto.cpp src/Dribbler/Dribbler.cpp \
      /tmp/rcmap.o -o /tmp/t && /tmp/t
  g++ -std=c++17 -Wall -Wextra -Werror -I test/host_stubs \
      test/manual_control_test.cpp test/host_stubs/host_stubs.cpp src/IO/ManualControl.cpp src/Auto/Auto.cpp src/Dribbler/Dribbler.cpp \
      /tmp/rcmap.o -o /tmp/t && /tmp/t

  # Ground STM32 command/status logic (tools/stm32_ground_control).
  g++ -std=c++17 -Wall -Wextra -Werror -I tools/stm32_ground_control/src -I src/IO \
      tools/stm32_ground_control/test/host_test_ground_state.cpp \
      tools/stm32_ground_control/src/GroundCommandState.cpp /tmp/rcmap.o -o /tmp/t && /tmp/t

  # Standalone Mega <-> STM32 UART link test protocol (src/Bench/UartLinkTest/ulink.c):
  # unit checks + 60 s two-endpoint simulation with drop/corrupt/late/dup/cut faults.
  # tools/stm32_mega_uart_test/build.py runs this before cross-compiling.
  gcc -std=c11 -Wall -Wextra -Werror -I src/Bench/UartLinkTest \
      tools/stm32_mega_uart_test/test/host_test_ulink.c src/Bench/UartLinkTest/ulink.c -o /tmp/t && /tmp/t

  # Single positional elevation servo: target slew, hold, clamp, stalled loop.
  g++ -std=c++17 -Wall -Wextra -Werror test/servo_position_jog_test.cpp -o /tmp/servo-jog && /tmp/servo-jog

  # Elevation angle <-> pulse map with the real ShooterConstants calibration.
  g++ -std=c++17 -Wall -Wextra -Werror test/servo_angle_map_test.cpp -o /tmp/t && /tmp/t

  # Single-wire conveyor ESC: pin, stop, run and emergency stop pulses.
  g++ -std=c++17 -Wall -Wextra -Werror -I test/host_stubs test/conveyor_esc_test.cpp test/host_stubs/host_stubs.cpp src/Dribbler/Dribbler.cpp -o /tmp/conveyor-esc-test && /tmp/conveyor-esc-test
